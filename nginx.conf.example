server {
  listen 80;
  server_name verticsecurity.com.au www.verticsecurity.com.au;
  return 301 https://www.verticsecurity.com.au$request_uri;
}
server {
  listen 443 ssl http2;
  server_name www.verticsecurity.com.au;
  root /var/www/verticsecurity;
  index index.html;
  location / { try_files $uri $uri/ $uri/index.html =404; }
  location ~* \.(css|js|jpg|jpeg|png|svg|webp|mp4)$ { expires 30d; add_header Cache-Control "public, immutable"; }
}
